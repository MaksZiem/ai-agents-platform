PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://ai_agents:ai_agents@localhost:5432/ai_agents_platform
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=AI Agent Platform <onboarding@resend.dev>
# 32+ random characters, e.g. openssl rand -hex 32. Encrypts connection secrets.
ENCRYPTION_KEY=change-me-to-a-long-random-string-of-32-chars
# Web search for the webSearch tool (https://tavily.com). Optional.
TAVILY_API_KEY=
# Usage limits that protect the Gemini quota. Optional, these are the defaults.
TOKEN_BUDGET_PER_EXECUTION=200000
DAILY_TOKEN_LIMIT_PER_USER=1000000
MAX_CONCURRENT_EXECUTIONS_PER_USER=3
MAX_EXECUTION_STARTS_PER_MINUTE=10
