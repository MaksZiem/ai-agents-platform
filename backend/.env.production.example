# Production config. On the server copy this file to backend/.env and fill in the values.
# Never commit the real file.

NODE_ENV=production
# Port the backend listens on (localhost only, the reverse proxy forwards to it).
PORT=3001
# Public URL of the frontend. Used for CORS and the Socket.IO origin check.
FRONTEND_URL=https://ai-agents-platform.zmax-dev.pl

# Database and user are created on the server (see DEPLOY.md).
DATABASE_URL=postgresql://ai_agents:CHANGE_ME@localhost:5432/ai_agents_platform
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# openssl rand -hex 32. Encrypts connection secrets in the database.
# Do not change it later, or saved connection secrets can no longer be decrypted.
ENCRYPTION_KEY=

GEMINI_API_KEY=
RESEND_API_KEY=
# The sender domain must be verified in Resend.
EMAIL_FROM=AI Agent Platform <noreply@zmax-dev.pl>
# Optional, enables the webSearch tool.
TAVILY_API_KEY=

# Usage limits that protect the Gemini quota (defaults).
TOKEN_BUDGET_PER_EXECUTION=200000
DAILY_TOKEN_LIMIT_PER_USER=1000000
MAX_CONCURRENT_EXECUTIONS_PER_USER=3
MAX_EXECUTION_STARTS_PER_MINUTE=10
# Daily AI calls per user (protects the Gemini quota, also on the demo account).
AI_DAILY_LIMIT_PER_USER=30
