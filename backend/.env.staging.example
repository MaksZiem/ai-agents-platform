# Test (staging) config. On the server copy this file to .env next to docker-compose.yml of the test copy and fill in the values.
# Use different secrets and database than production. Never commit the real file.

NODE_ENV=production
# Port the backend listens on (localhost only, the reverse proxy forwards to it).
PORT=3001
# Public URL of the test frontend. Used for CORS and the Socket.IO origin check.
FRONTEND_URL=https://ai-agents-platform-test.zmax-dev.pl

# Postgres in Docker creates the database and user from these values.
# docker-compose.yml builds DATABASE_URL and REDIS_URL from them.
DB_USER=ai_agents_test
DB_PASS=
DB_NAME=ai_agents_platform_test

# openssl rand -hex 32, different from production
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# openssl rand -hex 32, different from production. Do not change it later.
ENCRYPTION_KEY=

GEMINI_API_KEY=
RESEND_API_KEY=
# The sender domain must be verified in Resend.
EMAIL_FROM=AI Agent Platform (test) <noreply@zmax-dev.pl>
# Optional, enables the webSearch tool.
TAVILY_API_KEY=

# Usage limits that protect the Gemini quota. Lower than production, the test environment shares the key.
TOKEN_BUDGET_PER_EXECUTION=100000
DAILY_TOKEN_LIMIT_PER_USER=300000
MAX_CONCURRENT_EXECUTIONS_PER_USER=2
MAX_EXECUTION_STARTS_PER_MINUTE=5
# Daily AI calls per user (protects the Gemini quota, also on the demo account).
AI_DAILY_LIMIT_PER_USER=30

# Docker Compose on the server
# Separate Docker project name, keeps the test copy apart from production
COMPOSE_PROJECT_NAME=ai-agents-platform-test
# Image versions from GHCR: latest or a commit sha
BACKEND_TAG=latest
# The test frontend has the -test URLs built in, so it is a separate image
FRONTEND_TAG=test
# Ports on 127.0.0.1 that Caddy forwards to (different for every app and environment)
FRONTEND_PORT=3120
BACKEND_PORT=3121
