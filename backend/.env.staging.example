# Test (staging) config. On the server copy this file to backend/.env of the test copy and fill in the values.
# Use different secrets, database and Redis DB than production. Never commit the real file.

NODE_ENV=production
# Port the backend listens on (localhost only, the reverse proxy forwards to it).
PORT=3001
# Public URL of the test frontend. Used for CORS and the Socket.IO origin check.
FRONTEND_URL=https://ai-agents-platform-test.zmax-dev.pl

# Separate database and user for the test environment (see DEPLOY.md).
DATABASE_URL=postgresql://ai_agents_test:CHANGE_ME@localhost:5432/ai_agents_platform_test
# Redis DB 1 keeps test queues apart from production (DB 0).
REDIS_URL=redis://localhost:6379/1

# openssl rand -hex 32, different from production
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# openssl rand -hex 32, different from production. Do not change it later.
ENCRYPTION_KEY=

GEMINI_API_KEY=
RESEND_API_KEY=
# The sender domain must be verified in Resend.
EMAIL_FROM=AI Agent Platform (test) <noreply@zmax-dev.pl>
# Optional, enables the webSearch tool.
TAVILY_API_KEY=

# Usage limits that protect the Gemini quota. Lower than production, the test environment shares the key.
TOKEN_BUDGET_PER_EXECUTION=100000
DAILY_TOKEN_LIMIT_PER_USER=300000
MAX_CONCURRENT_EXECUTIONS_PER_USER=2
MAX_EXECUTION_STARTS_PER_MINUTE=5
