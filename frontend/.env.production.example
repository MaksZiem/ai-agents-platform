# Production config. On the server copy this file to frontend/.env.production.
# NEXT_PUBLIC_* values are baked in at `npm run build`, so rebuild after changing them.

# Backend REST API, called only from the Next.js server. Can stay on localhost
# when frontend and backend run on the same machine.
API_URL=http://localhost:3001/api
# Public Socket.IO address used by the browser (through the reverse proxy, https).
NEXT_PUBLIC_WS_URL=https://agents-api.example.com
